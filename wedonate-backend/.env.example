DATABASE_URL="postgresql://postgres:yourpassword@localhost:5432/wedonate_db"
JWT_SECRET="your-super-secret-jwt-key-change-in-production"
JWT_EXPIRES_IN="7d"
PORT=5000
NODE_ENV=development

# Chapa Payment Gateway (sign up at dashboard.chapa.co)
CHAPA_SECRET_KEY="CHASECK_TEST-xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx"
CHAPA_PUBLIC_KEY="CHAPUBK_TEST-xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx"
CHAPA_WEBHOOK_SECRET="your-webhook-secret"
CHAPA_BASE_URL="https://api.chapa.co/v1"

# Frontend URL for CORS and redirects
FRONTEND_URL="http://localhost:5173"

# Email (optional - for notifications)
SMTP_HOST="smtp.gmail.com"
SMTP_PORT=587
SMTP_USER="your@gmail.com"
SMTP_PASS="your-app-password"
