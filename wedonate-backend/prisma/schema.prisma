generator client {
  provider        = "prisma-client-js"
  previewFeatures = ["postgresqlExtensions"]
}

datasource db {
  provider   = "postgresql"
  url        = env("DATABASE_URL")
  extensions = [vector]
}

enum Role {
  USER
  ORGANIZATION
  KEBELE_ADMIN
  CITY_ADMIN
  SYSTEM_ADMIN
}

enum KebeleStatus {
  ACTIVE
  INACTIVE
}

model Kebele {
  id          String       @id @default(uuid())
  name        String       @unique
  status      KebeleStatus @default(ACTIVE)
  createdAt   DateTime     @default(now())
  updatedAt   DateTime     @updatedAt

  users       User[]

  @@map("kebeles")
}

enum VerificationStatus {
  UNVERIFIED
  PENDING
  CHANGES_REQUESTED
  VERIFIED
  REJECTED
  SUSPENDED
}

enum OrgType {
  NGO
  GOVERNMENTAL
  RELIGIOUS
  PRIVATE_CHARITY
}

enum DonationType {
  MONEY
  FOOD
  CLOTHES
  MEDICINE
  OTHER
}

enum RequestStatus {
  DRAFT
  PENDING_REVIEW
  PENDING_CITY_APPROVAL
  APPROVED
  CHANGES_REQUESTED
  PUBLISHED
  FULFILLED
  REJECTED
  CANCELLED
  ARCHIVED
}

enum CampaignStatus {
  DRAFT
  PENDING_REVIEW
  CHANGES_REQUESTED
  PUBLISHED
  COMPLETED
  REJECTED
  SUSPENDED
  CANCELLED
  ARCHIVED
}

enum RequestSource {
  SELF_SERVICE
  ASSISTED
}

enum PaymentStatus {
  PENDING
  SUCCESS
  FAILED
  REFUNDED
}

model User {
  id           String   @id @default(uuid())
  firstName    String
  lastName     String
  email        String   @unique
  phone        String?
  password     String
  role               Role     @default(USER)
  kebeleId           String?
  kebele             Kebele?  @relation(fields: [kebeleId], references: [id])
  verificationStatus VerificationStatus @default(UNVERIFIED)
  isActive           Boolean  @default(true)
  profileImage       String?
  registrationExpiry DateTime?  // org registration license expiry
  licenseExpiry      DateTime?  // org operating license expiry

  // Organization fields
  orgType            OrgType?
  orgName            String?
  licenseNumber      String?
  registrationDocUrl String?
  representativeName String?
  officeAddress      String?
  rejectionReason    String?

  // Identity Verification fields (for USER)
  nationalIdFrontUrl String?
  nationalIdBackUrl  String?
  fanNumber          String?
  verifiedById       String?
  verifiedByRole     String?
  verifiedAt         DateTime?

  // Assisted account fields
  accountSource      String   @default("SELF_REGISTERED")
  createdByAdminId   String?

  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  donations       Donation[]
  supportRequests SupportRequest[]
  campaigns       Campaign[]
  notifications   Notification[]
  auditLogs       AuditLog[]
  chatMessages    ChatMessage[]
  sentMessages    Message[]     @relation("SentMessages")
  receivedMessages Message[]    @relation("ReceivedMessages")
  inspections     InspectionReport[]

  @@map("users")
}

model SupportRequest {
  id           String        @id @default(uuid())
  userId       String?
  createdById  String?       // For ASSISTED requests (the Kebele Admin)
  kebeleId     String?       // Geographic scope
  source       RequestSource @default(SELF_SERVICE)
  user         User?         @relation(fields: [userId], references: [id])
  title        String
  description  String
  category     DonationType
  urgencyLevel Int           @default(1)
  goalAmount   Float?
  raisedAmount Float         @default(0)
  status       RequestStatus @default(DRAFT)
  adminNote    String?
  imageUrl     String?
  location     String?
  familySize   Int           @default(1)

  // Payment accounts — visible to donors
  telebirrAccount  String?
  cbeAccount       String?
  boaAccount       String?
  awashAccount     String?
  otherBankName    String?
  otherBankAccount String?

  // Contact for item donations
  requesterPhone   String?   // phone number for donors to contact when donating items

  // Admin-only information
  supportLetterUrl   String?   // official support letter image
  additionalNotes    String?   // extra info for admin

  // Beneficiary Snapshot (For ASSISTED requests where userId is null)
  beneficiaryName       String?
  beneficiaryIdType     String?
  beneficiaryIdNum      String?
  beneficiaryFrontIdUrl String?
  beneficiaryBackIdUrl  String?
  beneficiaryFanNumber  String?
  beneficiaryPhone      String?

  // Publishing
  isPublished Boolean  @default(false)
  publishedAt DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  donations          Donation[]
  inspectionReports  InspectionReport[]

  @@map("support_requests")
}

model Campaign {
  id           String         @id @default(uuid())
  userId       String
  user         User           @relation(fields: [userId], references: [id])
  title        String
  description  String
  category     String
  goalAmount   Float
  raisedAmount Float          @default(0)
  status       CampaignStatus @default(DRAFT)
  adminNote    String?
  imageUrl     String?
  deadline     DateTime?

  // Payment accounts — visible to donors
  telebirrAccount  String?
  cbeAccount       String?
  boaAccount       String?
  awashAccount     String?
  otherBankName    String?
  otherBankAccount String?

  // Contact for item donations
  requesterPhone   String?   // phone number for donors to contact when donating items

  // Admin-only information
  supportLetterUrl   String?
  additionalNotes    String?

  // Publishing
  isPublished Boolean  @default(false)
  publishedAt DateTime?

  // Impact gallery — success proof
  successPhotoUrl String?
  successNote     String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  donations          Donation[]
  updates            CampaignUpdate[]
  inspectionReports  InspectionReport[]

  @@map("campaigns")
}

model CampaignUpdate {
  id          String   @id @default(uuid())
  campaignId  String
  campaign    Campaign @relation(fields: [campaignId], references: [id])
  title       String
  content     String
  imageUrl    String?
  createdAt   DateTime @default(now())

  @@map("campaign_updates")
}

model Donation {
  id           String        @id @default(uuid())
  donorId      String
  donor        User          @relation(fields: [donorId], references: [id])
  amount       Float?
  currency     String        @default("ETB")
  donationType DonationType
  description  String?
  isAnonymous  Boolean       @default(false)

  // Payment method used
  paymentMethod    String?   // "CHAPA", "TELEBIRR", "CBE", "BOA", "AWASH", "OTHER_BANK", "ITEM"
  paymentProofUrl  String?   // screenshot/receipt image uploaded by donor
  referenceCode    String?   // bank ref code entered by donor
  itemDescription  String?   // for item donations
  itemImageUrl     String?   // photo of donated items
  deliveryMethod   String?   // "BRING_TO_OFFICE" | "DELIVER_TO_ADDRESS" | "COORDINATE"

  paymentStatus    PaymentStatus @default(PENDING)
  chapaRef         String?       @unique
  chapaCheckoutUrl String?

  // Admin verification fields
  verifiedAt       DateTime?
  verifiedBy       String?
  rejectionReason  String?

  supportRequestId String?
  supportRequest   SupportRequest? @relation(fields: [supportRequestId], references: [id])
  campaignId       String?
  campaign         Campaign?       @relation(fields: [campaignId], references: [id])

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("donations")
}

model GalleryPhoto {
  id          String   @id @default(uuid())
  imageUrl    String
  title       String
  description String?
  uploadedBy  String
  createdAt   DateTime @default(now())

  @@map("gallery_photos")
}

model Notification {
  id        String   @id @default(uuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id])
  title     String
  message   String
  isRead    Boolean  @default(false)
  type      String   @default("INFO")
  createdAt DateTime @default(now())

  @@map("notifications")
}

model AuditLog {
  id         String   @id @default(uuid())
  userId     String?
  user       User?    @relation(fields: [userId], references: [id])
  action     String
  resource   String
  resourceId String?
  details    String?
  ipAddress  String?
  createdAt  DateTime @default(now())

  @@map("audit_logs")
}

// -----------------------------------------------------------------------------
// RAG Knowledge Base Models (WeDonate AI Assistant)
// -----------------------------------------------------------------------------

enum RoleScope {
  GENERAL
  USER
  KEBELE_ADMIN
  CITY_ADMIN
}

model KnowledgeDocument {
  id        String   @id @default(uuid())
  name      String   @unique
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  chunks    KnowledgeChunk[]

  @@map("knowledge_documents")
}

model KnowledgeChunk {
  id           String            @id @default(uuid())
  documentId   String
  document     KnowledgeDocument @relation(fields: [documentId], references: [id], onDelete: Cascade)
  section      String?
  content      String
  roleScope    RoleScope         @default(GENERAL)
  
  // Gemini embedding-001 uses 3072 dimensions
  embedding    Unsupported("vector(3072)")?

  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  @@map("knowledge_chunks")
}

model Testimonial {
  id        String   @id @default(uuid())
  name      String
  role      String
  text      String
  avatar    String?
  rating    Int      @default(5)
  isActive  Boolean  @default(true)
  createdAt DateTime @default(now())

  @@map("testimonials")
}

model HeroImage {
  id        String   @id @default(uuid())
  imageUrl  String
  caption   String
  sortOrder Int      @default(0)
  isActive  Boolean  @default(true)
  createdAt DateTime @default(now())

  @@map("hero_images")
}

model News {
  id          String   @id @default(uuid())
  title       String
  content     String
  imageUrl    String?
  isPublished Boolean  @default(false)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@map("news")
}

model Faq {
  id        String   @id @default(uuid())
  question  String
  answer    String
  sortOrder Int      @default(0)
  isActive  Boolean  @default(true)
  createdAt DateTime @default(now())

  @@map("faqs")
}

enum EventStatus {
  DRAFT
  PUBLISHED
  CANCELLED
}

model Event {
  id          String      @id @default(uuid())
  title       String
  description String
  location    String?
  startDate   DateTime
  endDate     DateTime
  imageUrl    String?
  status      EventStatus @default(DRAFT)
  createdAt   DateTime    @default(now())
  updatedAt   DateTime    @updatedAt

  @@map("events")
}

model SiteSetting {
  id              String  @id @default("singleton")
  contactEmail    String?
  contactPhone    String?
  address         String?
  facebookUrl     String?
  twitterUrl      String?
  instagramUrl    String?
  telegramUrl     String?
  missionStatement String?
  aboutText       String?
  updatedAt       DateTime @updatedAt

  @@map("site_settings")
}

model Message {
  id          String   @id @default(uuid())
  senderId    String
  sender      User     @relation("SentMessages", fields: [senderId], references: [id])
  recipientId String?
  recipient   User?    @relation("ReceivedMessages", fields: [recipientId], references: [id])
  subject     String
  body        String
  isRead      Boolean  @default(false)
  createdAt   DateTime @default(now())

  @@map("messages")
}

enum InspectionStatus {
  PENDING
  RESOLVED
}

model InspectionReport {
  id              String          @id @default(uuid())
  inspectorId     String
  inspector       User            @relation(fields: [inspectorId], references: [id])
  supportRequestId String?
  supportRequest  SupportRequest? @relation(fields: [supportRequestId], references: [id])
  campaignId      String?
  campaign        Campaign?       @relation(fields: [campaignId], references: [id])
  status          InspectionStatus @default(PENDING)
  findings        String
  recommendation  String?
  imageUrl        String?
  createdAt       DateTime        @default(now())
  updatedAt       DateTime        @updatedAt

  @@map("inspection_reports")
}

model ChatMessage {
  id        String   @id @default(uuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  text      String
  isUser    Boolean
  timestamp DateTime @default(now())

  @@map("chat_messages")
}
